<% content_for :title, "Servers" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Servers</h1>
    <div class="flex items-center gap-2">
      <%= link_to "New server", new_server_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    </div>
  </div>

  <% if @servers.any? %>
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left font-semibold text-gray-600 w-16">#</th>
          <th class="px-4 py-3 text-left font-semibold text-gray-600">URL</th>
          <th class="px-4 py-3 text-left font-semibold text-gray-600">Login</th>
          <th class="px-4 py-3 text-left font-semibold text-gray-600 w-40">Created</th>
          <th class="px-4 py-3 w-16"></th>
          <th class="px-4 py-3 w-16"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @servers.each do |server| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-400"><%= server.id %></td>
            <td class="px-4 py-3 text-gray-800"><%= server.url %></td>
            <td class="px-4 py-3 text-gray-800"><%= server.login %></td>
            <td class="px-4 py-3 text-gray-500"><%= server.created_at.strftime("%b %d, %H:%M") %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "Show", server, class: "text-blue-600 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-right">
              <%= button_to "Delete", server, method: :delete, class: "text-red-500 hover:underline text-sm", form: { data: { turbo_confirm: "Delete this server?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center my-10 text-gray-500">No servers found.</p>
  <% end %>
</div>
