<% content_for :title, "Available Models" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Available Models</h1>
    <%= button_to "Sync Models", sync_available_models_path, method: :post, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  </div>

  <% if @available_models.any? %>
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left font-semibold text-gray-600">Name</th>
          <th class="px-4 py-3 text-left font-semibold text-gray-600 w-48">Updated</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @available_models.each do |model| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-800 font-mono"><%= model.name %></td>
            <td class="px-4 py-3 text-gray-500"><%= model.updated_at.strftime("%b %d, %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center my-10 text-gray-500">No models found. Models are synced automatically before each LLM job.</p>
  <% end %>
</div>
