<% content_for :title, "Editing available model" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing available model</h1>

  <%= render "form", available_model: @available_model %>

  <%= link_to "Show this available model", @available_model, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to available models", available_models_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
